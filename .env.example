# ForFuture — copy to .env for local development.
# On Netlify: Site settings → Environment variables (same names, no quotes required).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — used for password-reset / auth redirect URLs when set at build time.
# If unset, the app uses window.location.origin (works on Netlify after deploy).
# Set this on Netlify for reliable auth email links:
# VITE_APP_URL=https://fforfuture.netlify.app
#
# Local dev (optional; Vite defaults to http://localhost:5175):
# VITE_APP_URL=http://localhost:5175

# Google Maps JavaScript API (Impact Map + location pickers).
# In Google Cloud Console: restrict key to your site domains (HTTP referrer)
# and enable only: Maps JavaScript API, Places API, Geocoding API (as needed).
# NEVER put OPENAI_API_KEY in VITE_* — set it in Supabase Edge Function secrets only.
VITE_GOOGLE_MAPS_API_KEY=

# Optional map defaults (Sri Lanka center when location unavailable)
# VITE_MAP_DEFAULT_LAT=7.8731
# VITE_MAP_DEFAULT_LNG=80.7718
# VITE_MAP_COUNTRY_BIAS=lk

# Supabase → Edge Functions → Secrets (not VITE_*):
# OPENAI_API_KEY=sk-...
