# ForFuture — copy to .env for local development.
# On Netlify: Site settings → Environment variables (same names, no quotes required).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — used for password-reset / auth redirect URLs when set at build time.
# If unset, the app uses the browser origin (works on Netlify after deploy).
# VITE_APP_URL=https://your-site.netlify.app

# Optional — interactive map picker and static map previews (app works without it).
VITE_GOOGLE_MAPS_API_KEY=

# Optional map defaults
# VITE_MAP_DEFAULT_LAT=7.8731
# VITE_MAP_DEFAULT_LNG=80.7718
# VITE_MAP_COUNTRY_BIAS=lk

# Optional — Impact Map tile layer (OpenStreetMap used by default)
# VITE_MAP_TILE_URL=
# VITE_MAP_TILE_ATTRIBUTION=
