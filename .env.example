# ForFuture — copy to .env and fill in from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
# Use "anon public" key OR "publishable" key from the API settings
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — public app URL for password-reset email links (production). Defaults to window.location.origin in the browser.
# VITE_APP_URL=https://your-forfuture-domain.com

# ─── Google Maps (interactive picker + static previews) ───
# 1. Go to https://console.cloud.google.com/google/maps-apis/
# 2. Enable: Maps JavaScript API, Places API, Geocoding API, Maps Static API
# 3. Create an API key → restrict to HTTP referrers (localhost:5173/*, your domain/*)
# 4. Paste the key below and restart: npm run dev
VITE_GOOGLE_MAPS_API_KEY=

# Optional map defaults (defaults to Sri Lanka center if unset)
# VITE_MAP_DEFAULT_LAT=7.8731
# VITE_MAP_DEFAULT_LNG=80.7718
# VITE_MAP_COUNTRY_BIAS=lk

# Optional — Impact Map uses OpenStreetMap tiles by default
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
