# ForFuture — copy to .env and fill in from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
# Use "anon public" key OR "publishable" key from the API settings
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — enables map picker on Volunteer Drive & Peaceful Civic Action
# Get a key at https://console.cloud.google.com/ (Maps JavaScript API + Places API)
VITE_GOOGLE_MAPS_API_KEY=
