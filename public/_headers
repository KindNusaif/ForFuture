# Always fetch fresh HTML so production matches the latest deploy (previews use new URLs, so they look "correct").
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

# Boot helpers must never be cached across deploys
/boot.js
  Cache-Control: no-cache, no-store, must-revalidate

/deploy-sync.js
  Cache-Control: no-cache, no-store, must-revalidate

/theme-init.js
  Cache-Control: no-cache, no-store, must-revalidate

# Hashed Vite assets: safe to cache forever (filename changes each deploy)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
