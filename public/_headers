# Always fetch fresh HTML so production matches the latest deploy (previews use new URLs, so they look "correct").
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

# Boot helpers must never be cached across deploys
/boot.js
  Cache-Control: no-cache, no-store, must-revalidate

/deploy-sync.js
  Cache-Control: no-cache, no-store, must-revalidate

/theme-init.js
  Cache-Control: no-cache, no-store, must-revalidate

# Hashed assets: short TTL so deploys cannot strand stale JS/CSS on CDN edges
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate
